# Copy to .env. This file intentionally contains no working credentials.
# SQLite is convenient for a local demonstration; production supports PostgreSQL.
DATABASE_URL=sqlite:///invoice.db

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Keep this value stable across restarts and all web workers.
SECRET_KEY=
SUPERADMIN_EMAIL=admin@example.com
# At least 12 characters. Never reuse the former built-in default password.
SUPERADMIN_PASSWORD=

# Only enable for a loopback-only local demonstration. The desktop launcher sets it.
# In an HTTPS deployment set LOCAL_HTTP=false and list the actual public hostname.
LOCAL_HTTP=true
TRUSTED_HOSTS=localhost,127.0.0.1

# Optional SMTP: generate a Fernet key and keep it outside the database.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
SMTP_ALLOWED_HOSTS=

# Optional signatures: use a PRIVATE 'signatures' bucket in your own Supabase project.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

